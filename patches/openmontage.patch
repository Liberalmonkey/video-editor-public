index 0000000..e1f27ab
--- /dev/null
+++ b/remotion-composer/reel_kit.mjs
@@ -0,0 +1,47 @@
+// SplitReel sahne planı için ortak araçlar. Proje yalnız sahneleri ve altyazı düzeltmelerini yazar.
+// WHY: bkz. wiki/decisions/0017-terminal-hizli-hat.md. Bu mantık her projede elle tekrar ediliyordu.
+// Kullanım: work/edit/sahne.mjs içinde
+//   import { reel } from "<yol>/openmontage/remotion-composer/reel_kit.mjs";
+//   const r = reel(import.meta.url, "speaker");
+//   r.yaz({ scenes: [...], punches: [...], duzelt: [{ bul: ["Cloud"], yaz: "Claude" }] });
+import fs from "node:fs";
+
+const norm = (s) => s.toLocaleLowerCase("tr").replace(/[.,!?"'“”]/g, "");
+
+export function reel(sahneUrl, anahtar) {
+  const oku = (rel) => new URL(rel, sahneUrl);
+  const tr = JSON.parse(fs.readFileSync(oku("../analysis/transcript.json"), "utf-8"));
+  const seg = tr.files[anahtar]?.segments;
+  if (!seg) throw new Error(`transkript yok: ${anahtar}. vedit hazirla --ek ile ekle.`);
+  const words = seg.flatMap((s) => s.words).map((w) => ({ w: w.w, s: w.s, e: w.e }));
+
+  // Kelimeye kilitli zaman (checks.md: öğe kendi kelimesinde girsin).
+  const at = (kelime, nth = 1) => {
+    let n = 0;
+    for (const w of words) if (norm(w.w) === norm(kelime) && ++n === nth) return w.s;
+    throw new Error(`kelime yok: ${kelime} #${nth}`);
+  };
+
+  const yaz = ({ scenes, punches = [], speaker = "speaker.mp4", speakerZoom = 1.0, duzelt = [], emphasis = [] }) => {
+    for (let i = 1; i < scenes.length; i++) {
+      if (scenes[i].start < scenes[i - 1].end - 0.001) throw new Error(`sahne çakışması ${i}: ${scenes[i].start}`);
+      scenes[i].start = scenes[i - 1].end; // boşluk bırakma
+    }
+    for (const s of scenes) {
+      const d = s.end - s.start;
+      for (const [ad, liste] of [["satır", s.lines], ["vurgu", s.highlights], ["kicker", s.kicker], ["madde", s.items]]) {
+        for (const x of liste ?? []) if (x.at < 0 || x.at > d) throw new Error(`${ad} sahne dışında (${x.at} / ${d.toFixed(2)}): ${x.t ?? x.text ?? ""}`);
+      }
+    }
+    const capt = [];
+    for (let i = 0; i < words.length; i++) {
+      const d = duzelt.find((d) => d.bul.every((b, k) => words[i + k] && norm(words[i + k].w) === norm(b)));
+      if (d) { capt.push({ w: d.yaz, s: words[i].s, e: words[i + d.bul.length - 1].e }); i += d.bul.length - 1; d.ok = true; }
+      else capt.push(words[i]);
+    }
+    for (const d of duzelt) if (!d.ok) console.warn("! düzeltme eşleşmedi:", d.bul.join(" "));
+    fs.writeFileSync(oku("props.json"), JSON.stringify({ speaker, words: capt, scenes, punches, emphasis, speakerZoom }), "utf-8");
+    console.log(`${capt.length} kelime · ${scenes.length} sahne · ${scenes.at(-1).end.toFixed(2)} sn`);
+  };
+  return { words, at, yaz };
+}
