+def _add_cuda_dll_dirs() -> None:
+    """Windows: CTranslate2 needs cublas64_12.dll / cudnn64_9.dll; no CUDA Toolkit is installed,
+    so load them from the venv's torch/lib or nvidia-* wheels."""
+    if os.name != "nt":
+        return
+    root = Path(sys.prefix) / "Lib" / "site-packages"
+    dirs = [root / "torch" / "lib", *root.glob("nvidia/*/bin")]
+    for d in dirs:
+        if (d / "cublas64_12.dll").exists() or (d / "cudnn64_9.dll").exists():
+            os.add_dll_directory(str(d))
+            os.environ["PATH"] = str(d) + os.pathsep + os.environ.get("PATH", "")
+
