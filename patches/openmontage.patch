 import { cancelRender, continueRender, delayRender } from "remotion";
 
+import montserratUrl from "../fonts/Montserrat-Variable.ttf";
 import playfairItalicUrl from "../fonts/PlayfairDisplay-Italic-latin.woff2";
 import playfairUrl from "../fonts/PlayfairDisplay-latin.woff2";
 import spaceGroteskUrl from "../fonts/SpaceGrotesk-latin.woff2";
@@ -49,7 +50,27 @@ const register = (family: string, url: string, style: "normal" | "italic", weigh
   return family;
 };
 
-export const loadSpaceGrotesk = (weights: string[]) => ({ fontFamily: register("Space Grotesk", spaceGroteskUrl, "normal", weights) });
+// Altyazı standardı (video-editor ADR 0014). unicodeRange yok: LATIN aralığı ş, ğ, İ harflerini kapsamaz.
+let captionFontQueued = false;
+export const loadCaptionFont = () => {
+  const family = "Montserrat";
+  if (typeof FontFace === "undefined" || captionFontQueued) return { fontFamily: family };
+  captionFontQueued = true;
+  queueMicrotask(() => {
+    const handle = delayRender("Loading caption font Montserrat");
+    const face = new FontFace(family, `url(${montserratUrl}) format('truetype')`, { weight: "100 900" });
+    face
+      .load()
+      .then(() => {
+        document.fonts.add(face);
+        continueRender(handle);
+      })
+      .catch((err) => cancelRender(new Error(`Caption font failed to load: ${err}`)));
+  });
+  return { fontFamily: family };
+};
+
+export const loadSpaceGrotesk =(weights: string[]) => ({ fontFamily: register("Space Grotesk", spaceGroteskUrl, "normal", weights) });
 export const loadPlayfair = (style: "normal" | "italic", weights: string[]) => ({
   fontFamily: register("Playfair Display", style === "italic" ? playfairItalicUrl : playfairUrl, style, weights),
 });
