diff --git a/remotion-composer/src/SplitReel.tsx b/remotion-composer/src/SplitReel.tsx
new file mode 100644
index 0000000..fb0e54d
--- /dev/null
+++ b/remotion-composer/src/SplitReel.tsx
@@ -0,0 +1,418 @@
+import React, { useEffect, useState } from "react";
+import {
+  AbsoluteFill,
+  Easing,
+  Img,
+  OffthreadVideo,
+  Sequence,
+  continueRender,
+  delayRender,
+  interpolate,
+  staticFile,
+  useCurrentFrame,
+  useVideoConfig,
+} from "remotion";
+import { loadCaptionFont } from "./lib/localFonts";
+
+const CAPTION_FONT = loadCaptionFont().fontFamily;
+
+// WHY: bkz. wiki/specs/instagram-studyosu.md + studios/instagram/styles/ai-reels (STYLE.md, MOTION.md)
+// Bölünmüş ekran Reels: üst %52 içerik kartı, alt %48 konuşmacı, karaoke altyazı.
+
+const W = 1080;
+const H = 1920;
+export const STAGE_H = 998;
+export const CAP_Y = 1402; // %73 yükseklik (tam ekran)
+export const CAP_SPLIT_Y = 1066; // bölünmüşte yüzün üstü, panel kenarı
+
+export const T = {
+  bg: "#0B0D12",
+  surface: "#151922",
+  light: "#F2F1EC",
+  fg: "#F5F6F8",
+  ink: "#0B0D12",
+  muted: "#8A93A3",
+  mutedLight: "#5B6472",
+  accent: "#FFD400",
+  accent2: "#3EE6C9",
+  down: "#FF4D5E",
+};
+const DISPLAY = "'Space Grotesk', sans-serif";
+const BODY = "'Inter', sans-serif";
+const MONO = "'JetBrains Mono', monospace";
+
+export const FONTS: [string, string][] = [
+  ["Space Grotesk", "fonts/SpaceGrotesk-Variable.ttf"],
+  ["Inter", "fonts/Inter-Variable.ttf"],
+  ["JetBrains Mono", "fonts/JetBrainsMono-Variable.ttf"],
+];
+
+// ---------------------------------------------------------------- types
+export interface Word { w: string; s: number; e: number }
+export interface Highlight { x: number; y: number; w: number; h: number; at: number }
+export interface Focus { x: number; y: number; w: number }
+export interface SceneBase {
+  start: number;
+  end: number;
+  layout: "full" | "split";
+  bg?: "dark" | "light" | "saydam";
+  kind?: "shot" | "stat" | "text" | "chips" | "timeline" | "steps" | "hook" | "cta";
+  kicker?: { at: number; text: string }[];
+  source?: string;
+  [k: string]: any;
+}
+export interface SplitReelProps {
+  speaker: string;
+  words: Word[];
+  scenes: SceneBase[];
+  punches: number[];
+  emphasis: string[];
+  speakerZoom: number;
+}
+
+// ---------------------------------------------------------------- helpers
+export const OUT4 = Easing.bezier(0.16, 1, 0.3, 1);
+export const ez = (f: number, a: number, b: number, e: (t: number) => number = OUT4) =>
+  interpolate(f, [a, b], [0, 1], { extrapolateLeft: "clamp", extrapolateRight: "clamp", easing: e });
+
+const useT = () => {
+  const frame = useCurrentFrame();
+  const { fps } = useVideoConfig();
+  return { frame, fps, t: frame / fps };
+};
+
+const Reveal: React.FC<{ at?: number; dy?: number; style?: React.CSSProperties; children: React.ReactNode }> = ({
+  at = 0, dy = 36, style, children,
+}) => {
+  const { frame, fps } = useT();
+  const k = ez(frame, at * fps, at * fps + 11);
+  return <div style={{ opacity: k, transform: `translateY(${(1 - k) * dy}px)`, ...style }}>{children}</div>;
+};
+
+const themeOf = (bg?: string) =>
+  bg === "light"
+    ? { fg: T.ink, muted: T.mutedLight, surface: "#FFFFFF", num: T.ink, line: "rgba(11,13,18,0.14)" }
+    : { fg: T.fg, muted: T.muted, surface: T.surface, num: T.accent, line: "rgba(255,255,255,0.14)" };
+
+const Kicker: React.FC<{ items: { at: number; text: string }[]; bg?: string }> = ({ items, bg }) => {
+  const { t } = useT();
+  const th = themeOf(bg);
+  let cur = items[0];
+  for (const it of items) if (t >= it.at) cur = it;
+  if (!cur) return null;
+  return (
+    <Reveal style={{ position: "absolute", left: 70, top: 252, display: "flex", alignItems: "center", gap: 16 }}>
+      <div style={{ width: 16, height: 16, background: T.accent, borderRadius: 4 }} />
+      <div style={{ fontFamily: MONO, fontWeight: 500, fontSize: 30, letterSpacing: 2, color: th.fg, textTransform: "uppercase" }}>
+        {cur.text}
+      </div>
+    </Reveal>
+  );
+};
+
+const Source: React.FC<{ text?: string; bg?: string }> = ({ text, bg }) => {
+  if (!text) return null;
+  const th = themeOf(bg);
+  return (
+    <Reveal at={0.5} dy={10} style={{ position: "absolute", left: 70, top: 928, fontFamily: MONO, fontSize: 26, color: th.muted }}>
+      kaynak: {text}
+    </Reveal>
+  );
+};
+
+// ---------------------------------------------------------------- scene kinds
+const Shot: React.FC<{ s: SceneBase }> = ({ s }) => {
+  const { frame, fps, t } = useT();
+  const dur = (s.end - s.start) * fps;
+  const CW = 1000, CH = s.cardH ?? 560;
+  const IW = s.iw ?? 1919, IH = s.ih ?? 884; // ekran görüntüsünün kendi ölçüsü; oranı bozmadan yerleştir
+  const f1: Focus = s.focus, f2: Focus = s.focus2 ?? s.focus;
+  const k = ez(frame, 0, dur, Easing.bezier(0.45, 0, 0.2, 1));
+  const fx = f1.x + (f2.x - f1.x) * k, fy = f1.y + (f2.y - f1.y) * k, fw = f1.w + (f2.w - f1.w) * k;
+  const sc = CW / fw;
+  const th = themeOf(s.bg);
+  return (
+    <div style={{ position: "absolute", left: 40, top: s.cardTop ?? 330, width: CW, height: CH, borderRadius: 28, overflow: "hidden",
+      background: "#fff", boxShadow: "0 24px 60px rgba(0,0,0,0.35)", border: `2px solid ${th.line}` }}>
+      <div style={{ position: "absolute", left: 0, top: 0, width: IW, height: IH, transformOrigin: "0 0",
+        transform: `translate(${-fx * sc}px, ${-fy * sc}px) scale(${sc})` }}>
+        <Img src={staticFile(s.img)} style={{ width: IW, height: IH, display: "block" }} />
+        {(s.highlights as Highlight[] | undefined)?.map((h, i) => {
+          const hk = ez(frame, h.at * fps, h.at * fps + 9, Easing.bezier(0.34, 1.56, 0.64, 1));
+          const pad = 8 / sc;
+          return (
+            <div key={i} style={{ position: "absolute", left: h.x - pad, top: h.y - pad, width: h.w + pad * 2, height: h.h + pad * 2,
+              border: `${6 / sc}px solid ${T.accent}`, borderRadius: 14 / sc, opacity: hk,
+              transform: `scale(${0.92 + 0.08 * hk})`, boxShadow: `0 0 ${30 / sc}px rgba(255,212,0,0.45)` }} />
+          );
+        })}
+      </div>
+    </div>
+  );
+};
+
+const Stat: React.FC<{ s: SceneBase }> = ({ s }) => {
+  const { frame, fps } = useT();
+  const th = themeOf(s.bg);
+  const d = s.decimals ?? 0;
+  const k = ez(frame, 0.15 * fps, 0.15 * fps + 1.2 * fps, Easing.out(Easing.exp));
+  const val = s.value * k;
+  const done = frame > 0.15 * fps + 1.2 * fps;
+  const pop = done ? 1 + 0.06 * Math.sin(Math.min(1, (frame - (0.15 + 1.2) * fps) / (0.3 * fps)) * Math.PI) : 1;
+  const txt = val.toLocaleString("tr-TR", { minimumFractionDigits: d, maximumFractionDigits: d });
+  const numTop = s.shot ? 290 : 340;
+  return (
+    <>
+      <Reveal at={0.05} style={{ position: "absolute", left: 70, top: numTop, display: "flex", alignItems: "baseline", gap: 18, transform: `scale(${pop})`, transformOrigin: "0 60%" }}>
+        {s.prefix && <span style={{ fontFamily: DISPLAY, fontWeight: 700, fontSize: s.shot ? 130 : 200, color: th.num }}>{s.prefix}</span>}
+        <span style={{ fontFamily: DISPLAY, fontWeight: 700, fontSize: s.shot ? 190 : 330, lineHeight: 1, color: th.num, fontVariantNumeric: "tabular-nums" }}>{txt}</span>
+        {s.unit && <span style={{ fontFamily: DISPLAY, fontWeight: 700, fontSize: s.shot ? 80 : 120, color: th.fg }}>{s.unit}</span>}
+      </Reveal>
+      <div style={{ position: "absolute", left: 70, top: numTop + (s.shot ? 200 : 340), width: 360 * ez(frame, 0.3 * fps, 0.3 * fps + 14), height: 16, background: T.accent, borderRadius: 4 }} />
+      <Reveal at={0.45} style={{ position: "absolute", left: 70, top: numTop + (s.shot ? 236 : 390), width: 860, fontFamily: BODY, fontWeight: 700, fontSize: 48, lineHeight: 1.2, color: th.fg }}>
+        {s.label}
+      </Reveal>
+      {s.shot && (
+        <Reveal at={0.5} dy={30}>
+          <Shot s={{ ...s, ...s.shot, bg: s.bg, start: s.start, end: s.end } as SceneBase} />
+        </Reveal>
+      )}
+    </>
+  );
+};
+
+const TextScene: React.FC<{ s: SceneBase }> = ({ s }) => {
+  const th = themeOf(s.bg);
+  return (
+    <div style={{ position: "absolute", left: 70, top: 350, width: 880 }}>
+      {(s.lines as { t: string; size?: number; accent?: boolean; at?: number }[]).map((l, i) => (
+        <Reveal key={i} at={l.at ?? 0.1 + i * 0.28} style={{ marginBottom: 10 }}>
+          <span style={{ fontFamily: DISPLAY, fontWeight: 700, fontSize: l.size ?? 96, lineHeight: 1.08, letterSpacing: -1,
+            color: l.accent ? th.num : th.fg,
+            background: l.accent ? `linear-gradient(transparent 82%, ${T.accent} 82%)` : undefined }}>{l.t}</span>
+        </Reveal>
+      ))}
+    </div>
+  );
+};
+
+const Check: React.FC<{ size?: number; p: number }> = ({ size = 64, p }) => (
+  <svg width={size} height={size} viewBox="0 0 64 64">
+    <circle cx="32" cy="32" r="30" fill={T.accent} />
+    <path d="M18 33 L28 43 L47 22" fill="none" stroke={T.ink} strokeWidth="7" strokeLinecap="round" strokeLinejoin="round"
+      strokeDasharray="60" strokeDashoffset={60 * (1 - p)} />
+  </svg>
+);
+
+const Chips: React.FC<{ s: SceneBase }> = ({ s }) => {
+  const { frame, fps } = useT();
+  const th = themeOf(s.bg);
+  const items = s.items as { t: string; at: number; done: number }[];
+  return (
+    <div style={{ position: "absolute", left: 40, top: 340, width: 1000 }}>
+      {items.map((it, i) => (
+        <Reveal key={i} at={it.at} style={{ display: "flex", alignItems: "center", justifyContent: "space-between", height: 170, marginBottom: 28,
+          padding: "0 48px", borderRadius: 32, background: th.surface, border: `2px solid ${th.line}`, boxShadow: "0 12px 40px rgba(0,0,0,0.18)" }}>
+          <span style={{ fontFamily: DISPLAY, fontWeight: 700, fontSize: 92, color: th.fg }}>{it.t}</span>
+          <Check p={ez(frame, it.done * fps, it.done * fps + 10)} size={84} />
+        </Reveal>
+      ))}
+      <Reveal at={s.banner.at} dy={20}>
+        <div style={{ display: "inline-block", marginTop: 12, padding: "14px 34px", borderRadius: 18, background: T.accent, color: T.ink,
+          fontFamily: DISPLAY, fontWeight: 700, fontSize: 64 }}>{s.banner.text}</div>
+      </Reveal>
+    </div>
+  );
+};
+
+const Timeline: React.FC<{ s: SceneBase }> = ({ s }) => {
+  const { frame, fps } = useT();
+  const th = themeOf(s.bg);
+  const nodes = s.nodes as { date: string; text: string; at: number; y: number }[];
+  const lineK = ez(frame, s.line.at * fps, s.line.at * fps + 14);
+  const y0 = nodes[0].y + 62, y1 = nodes[1].y + 20;
+  return (
+    <div style={{ position: "absolute", inset: 0 }}>
+      <div style={{ position: "absolute", left: 128, top: y0, width: 8, height: (y1 - y0) * lineK, background: T.accent, borderRadius: 4 }} />
+      {nodes.map((n, i) => (
+        <Reveal key={i} at={n.at} style={{ position: "absolute", left: 70, top: n.y, width: 860, display: "flex", gap: 36, alignItems: "flex-start" }}>
+          <div style={{ width: 120, height: 120, marginTop: -6, borderRadius: 60, background: i === 0 ? T.accent : th.surface, border: `6px solid ${T.accent}`, flex: "none", boxSizing: "border-box" }} />
+          <div>
+            <div style={{ fontFamily: DISPLAY, fontWeight: 700, fontSize: 104, lineHeight: 1, color: th.fg }}>{n.date}</div>
+            <div style={{ fontFamily: BODY, fontWeight: 700, fontSize: 44, marginTop: 8, color: th.muted }}>{n.text}</div>
+          </div>
+        </Reveal>
+      ))}
+      <Reveal at={s.line.at + 0.1} dy={10} style={{ position: "absolute", left: 226, top: y1 - 170, padding: "8px 28px", borderRadius: 18, background: T.accent }}>
+        <span style={{ fontFamily: DISPLAY, fontWeight: 700, fontSize: 96, color: T.ink }}>{s.line.text}</span>
+      </Reveal>
+    </div>
+  );
+};
+
+const Steps: React.FC<{ s: SceneBase }> = ({ s }) => {
+  const th = themeOf(s.bg);
+  return (
+    <div style={{ position: "absolute", left: 40, top: 340, width: 1000 }}>
+      {(s.items as { n: string; t: string; at: number }[]).map((it, i) => (
+        <Reveal key={i} at={it.at} style={{ display: "flex", alignItems: "center", gap: 32, height: 168, marginBottom: 26, padding: "0 40px",
+          borderRadius: 28, background: th.surface, border: `2px solid ${th.line}` }}>
+          <span style={{ fontFamily: MONO, fontWeight: 500, fontSize: 64, color: T.accent }}>{it.n}</span>
+          <span style={{ fontFamily: DISPLAY, fontWeight: 700, fontSize: 58, lineHeight: 1.1, color: th.fg }}>{it.t}</span>
+        </Reveal>
+      ))}
+    </div>
+  );
+};
+
+// Tam ekran konuşmacı üstündeki başlık / CTA kutusu (ilk kare = son kare kompozisyonu)
+export const FullTitle: React.FC<{ s: SceneBase }> = ({ s }) => {
+  const { frame, fps } = useT();
+  const k = ez(frame, 0, 10);
+  const out = 1 - ez(frame, (s.end - s.start) * fps - 6, (s.end - s.start) * fps);
+  return (
+    <div style={{ position: "absolute", left: 70, top: 1010, width: 860, opacity: Math.min(k, s.kind === "hook" ? out : 1), transform: `translateY(${(1 - k) * 30}px)` }}>
+      <div style={{ display: "inline-block", padding: "10px 34px 14px", borderRadius: 22, background: T.accent, boxShadow: "0 16px 40px rgba(0,0,0,0.4)" }}>
+        <span style={{ fontFamily: DISPLAY, fontWeight: 700, fontSize: s.size ?? 150, lineHeight: 1.05, color: T.ink }}>{s.title}</span>
+      </div>
+      <div style={{ marginTop: 20, fontFamily: DISPLAY, fontWeight: 700, fontSize: 64, lineHeight: 1.1, color: "#fff",
+        textShadow: "0 3px 18px rgba(0,0,0,0.8)", WebkitTextStroke: "0px" }}>{s.subtitle}</div>
+    </div>
+  );
+};
+
+export const StageScene: React.FC<{ s: SceneBase }> = ({ s }) => {
+  const bg = s.bg === "light" ? T.light : s.bg === "saydam" ? "transparent" : T.bg; // saydam: video-editor Kurgu.tsx tam ekran sahnesi (ADR 0031)
+  return (
+    <AbsoluteFill style={{ height: STAGE_H, background: bg }}>
+      {s.kicker && <Kicker items={s.kicker} bg={s.bg} />}
+      {s.kind === "shot" && <Shot s={s} />}
+      {s.kind === "stat" && <Stat s={s} />}
+      {s.kind === "text" && <TextScene s={s} />}
+      {s.kind === "chips" && <Chips s={s} />}
+      {s.kind === "timeline" && <Timeline s={s} />}
+      {s.kind === "steps" && <Steps s={s} />}
+      <Source text={s.source} bg={s.bg} />
+    </AbsoluteFill>
+  );
+};
+
+// ---------------------------------------------------------------- speaker
+export const layoutP = (frame: number, fps: number, scenes: SceneBase[]) => {
+  let prev = 0, p = 0;
+  for (const s of scenes) {
+    const target = s.layout === "split" ? 1 : 0;
+    const st = Math.round(s.start * fps);
+    if (frame < st) break;
+    const k = ez(frame, st, st + 10, Easing.bezier(0.65, 0, 0.35, 1));
+    p = prev + (target - prev) * k;
+    prev = target;
+  }
+  return p;
+};
+
+const Speaker: React.FC<{ p: SplitReelProps }> = ({ p: props }) => {
+  const { frame, fps } = useT();
+  const lp = layoutP(frame, fps, props.scenes);
+  const top = STAGE_H * lp;
+  let punch = 1;
+  for (const t0 of props.punches) {
+    const a = t0 * fps;
+    punch += 0.1 * (ez(frame, a, a + 8, Easing.bezier(0.34, 1.4, 0.64, 1)) - ez(frame, a + 30, a + 40, Easing.bezier(0.45, 0, 0.55, 1)));
+  }
+  // WHY: tam ekranda 1.16 taban zoom kaynak çekimin alt köşesindeki filigranı kadraj dışında bırakır; bölünmüşte panel alt kısmı zaten kırpar
+  const z = (props.speakerZoom + (1 - props.speakerZoom) * lp) * punch;
+  return (
+    <div style={{ position: "absolute", left: 0, top, width: W, height: H - top, overflow: "hidden", borderRadius: `${40 * lp}px ${40 * lp}px 0 0`, background: T.bg }}>
+      <OffthreadVideo src={staticFile(props.speaker)} style={{ position: "absolute", left: 0, top: 0, width: W, height: H, transformOrigin: "50% 0%",
+        transform: `translateY(${-273 * lp}px) scale(${z})` }} />
+    </div>
+  );
+};
+
+// ---------------------------------------------------------------- captions
+const clean = (w: string) => w.trim().replace(/^zeka(ya)?$/i, (m) => (m.toLowerCase() === "zeka" ? "zekâ" : "zekâya"));
+interface Tok { text: string; s: number; e: number }
+export const buildTokens = (words: Word[]): Tok[] => {
+  const out: Tok[] = [];
+  for (const w of words) {
+    const txt = w.w.trim();
+    if (out.length && /^['’,]/.test(txt)) {
+      const prev = out[out.length - 1];
+      prev.text = prev.text.replace(/[.,]$/, "") + txt;
+      prev.e = w.e;
+    } else out.push({ text: clean(txt), s: w.s, e: w.e });
+  }
+  return out;
+};
+export const buildPages = (toks: Tok[], enKelime = 3, enKarakter = 18) => {
+  const pages: Tok[][] = [];
+  let cur: Tok[] = [];
+  for (const t of toks) {
+    const len = [...cur, t].map((x) => x.text).join(" ").length;
+    if (cur.length && (cur.length >= enKelime || len > enKarakter)) { pages.push(cur); cur = []; }
+    cur.push(t);
+    if (/[.!?]$/.test(t.text)) { pages.push(cur); cur = []; }
+  }
+  if (cur.length) pages.push(cur);
+  return pages;
+};
+
+export const Captions: React.FC<{ p: SplitReelProps }> = ({ p }) => {
+  const { t, frame, fps } = useT();
+  const capY = CAP_Y + (CAP_SPLIT_Y - CAP_Y) * layoutP(frame, fps, p.scenes);
+  const pages = React.useMemo(() => buildPages(buildTokens(p.words)), [p.words]);
+  const idx = pages.findIndex((pg, i) => t >= pg[0].s - 0.04 && t < (pages[i + 1] ? pages[i + 1][0].s - 0.04 : pg[pg.length - 1].e + 0.5));
+  if (idx < 0) return null;
+  const pg = pages[idx];
+  if (t > pg[pg.length - 1].e + 0.45) return null;
+  return (
+    <div style={{ position: "absolute", left: 0, width: W, top: capY - 50, height: 100, display: "flex", justifyContent: "center", alignItems: "center", gap: 20 }}>
+      {pg.map((tok, i) => {
+        const next = pg[i + 1];
+        const active = t >= tok.s && (next ? t < next.s : t < tok.e + 0.3);
+        // Altyazı standardı (ADR 0014): okunan kelime turuncu, gerisi beyaz, siyah kontur, Montserrat.
+        return (
+          <span key={i} style={{ fontFamily: CAPTION_FONT, fontWeight: 800, fontSize: 72, lineHeight: 1, display: "inline-block",
+            color: active ? "#FF7A00" : "#FFFFFF", transition: "none",
+            WebkitTextStroke: "12px #000", paintOrder: "stroke fill" as any }}>{tok.text}</span>
+        );
+      })}
+    </div>
+  );
+};
+
+// ---------------------------------------------------------------- root
+export const SplitReel: React.FC<SplitReelProps> = (props) => {
+  const { fps } = useVideoConfig();
+  const [handle] = useState(() => delayRender("fonts"));
+  useEffect(() => {
+    Promise.all(
+      FONTS.map(([name, path]) => new FontFace(name, `url(${staticFile(path)})`, { weight: "100 900" }).load().then((f) => document.fonts.add(f))),
+    ).then(() => continueRender(handle)).catch(() => continueRender(handle));
+  }, [handle]);
+
+  const sc = props.scenes;
+  return (
+    <AbsoluteFill style={{ background: T.bg }}>
+      {sc.map((s, i) => {
+        if (s.layout !== "split") return null;
+        const extra = sc[i + 1]?.layout === "full" ? 10 : 0;
+        return (
+          <Sequence key={`st${i}`} from={Math.round(s.start * fps)} durationInFrames={Math.round((s.end - s.start) * fps) + extra}>
+            <StageScene s={s} />
+          </Sequence>
+        );
+      })}
+      <Speaker p={props} />
+      {sc.map((s, i) =>
+        s.layout === "full" && (s.kind === "hook" || s.kind === "cta") ? (
+          <Sequence key={`fu${i}`} from={Math.round(s.start * fps)} durationInFrames={Math.round((s.end - s.start) * fps)}>
+            <FullTitle s={s} />
+          </Sequence>
+        ) : null,
+      )}
+      <Captions p={props} />
+    </AbsoluteFill>
+  );
+};
